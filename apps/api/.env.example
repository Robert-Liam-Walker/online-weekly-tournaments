DATABASE_URL=postgresql://foxtrot:foxtrot@localhost:5432/foxtrot
REDIS_URL=redis://localhost:6379
JWT_SECRET=change-me-to-a-long-random-string   # REQUIRED — the API refuses to boot without it
PORT=3001                                       # HTTP + Socket.io share this port
WEB_URL=http://localhost:5173

# Operator bootstrap: this email is promoted to ADMIN at boot and at
# registration (production has no DB shell access).
ADMIN_EMAIL=

# Set to "true" to enable paid events (entry-fee creation, Stripe
# registration). Anything else (or unset) = free only.
PAID_EVENTS_ENABLED=false

# Minutes a ready match may sit before absent players are auto-DQ'd by the
# per-minute sweep ("0" disables; presence = the game's /ready polls).
READY_TIMEOUT_MINUTES=10

# Pino log level (debug|info|warn|error). Default info.
LOG_LEVEL=info

# Verified SES sender for password-reset email. Unset = emails are logged to
# the console instead (dev fallback). SES region is us-east-1.
SES_FROM_EMAIL=

# Launcher update manifest (GET /api/launcher/manifest). All optional —
# unset sections are served as null until the first release artifacts exist.
FOXTROT_DOLPHIN_VERSION=
FOXTROT_DOLPHIN_WIN_URL=
FOXTROT_DOLPHIN_PLAYBACK_VERSION=
FOXTROT_DOLPHIN_PLAYBACK_WIN_URL=
FOXTROT_GAMEFILES_VERSION=
FOXTROT_GAMEFILES_URL=
FOXTROT_GAMEFILES_SHA256=
FOXTROT_LAUNCHER_MIN_VERSION=

# Stripe — get from dashboard.stripe.com
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...   # Your $5/month recurring price ID

# S3-compatible storage for replay uploads
S3_BUCKET=foxtrot-replays
S3_ENDPOINT=https://s3.amazonaws.com
S3_REGION=us-east-1
AWS_ACCESS_KEY_ID=...
AWS_SECRET_ACCESS_KEY=...
